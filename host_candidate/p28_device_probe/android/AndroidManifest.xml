<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.dsh.p28.nodeprobe">
  <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35"/>
  <!-- No INTERNET, external storage, camera, mic, overlay, accessibility,
       package install, debugging, notification or privileged permissions. -->
  <application android:label="DSH P28 原版Node离线验证（非正式DSH）"
      android:extractNativeLibs="true"
      android:usesCleartextTraffic="false"
      android:allowBackup="false"
      android:debuggable="false">
    <activity android:name=".P28Activity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name=".P28Worker" android:process=":isolate"
      android:isolatedProcess="true" android:exported="false"/>
  </application>
</manifest>
